<Window x:Class="BingWallPaperTest.Views.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BingWallPaperTest.Views"
        mc:Ignorable="d"
        Title="DownloadWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Background="#ccc" Height="55" MouseLeftButtonDown="HeadBar_MouseLeftButtonDown">
            <TextBlock Text="批量下载" FontSize="28" Margin="10" HorizontalAlignment="Left"/>
            <Button Name="BtnClose" Content="&#xEF2C;" ToolTip="关闭" Style="{StaticResource BtnInfoStyle}" Click="BtnClose_Click" HorizontalAlignment="Right" Margin="10"/>
        </Grid>
        <Grid Grid.Row="1" Margin="10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="下载日期区间：" FontSize="17" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <DatePicker Name="dpStart" VerticalAlignment="Center" Width="180" FontSize="16" Cursor="Hand"/>
                <TextBlock Text="————" VerticalAlignment="Center" Margin="10"/>
                <DatePicker Name="dpEnd" VerticalAlignment="Center" Width="180" FontSize="16" Cursor="Hand"/>
            </StackPanel>
            <Button Grid.Column="2" Name="btnDownload" Content="开始下载" FontSize="18" Width="100" Height="35" Click="btnDownload_Click"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="tbPicCount" Text="本地：0张" VerticalAlignment="Center" FontSize="16" Margin="10" Foreground="#888"/>
            <ProgressBar Name="pbDownload" Grid.Column="1" Height="10"></ProgressBar>
            <TextBlock Name="tbProcess" Grid.Column="2" Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="16" Margin="10" Foreground="#888"/>
        </Grid>

        <TextBox Name="tBoxDetail" Grid.Row="3" FontSize="14" Background="#3ddd" Margin="10 0"/>
    </Grid>
</Window>
